# ==============================================================================
# BA Attendance - environment variables
#
# Copy this file to .env.local for local work, and set the same names in your
# host (Vercel: Project > Settings > Environment Variables) for the live site.
# Never commit real values. In production the app refuses to run on the
# placeholder values below: generate your own (commands are in README.md).
# ==============================================================================

# --- Supabase (Project Settings > API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Bypasses Row Level Security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Attendance pass encryption (server only) ---------------------------------
# 24 random bytes as 48 hex characters.
QR_3DES_SECRET_KEY=replace-with-48-hex-characters
# 32 random bytes as 64 hex characters.
QR_HMAC_SECRET_KEY=replace-with-64-hex-characters
# Label stored in each pass; change it only when you rotate the keys.
QR_KEY_VERSION=k1

# --- Staff sign-in (server only) -----------------------------------------------
# Signs the staff session cookie and encrypts exported reports. Any long random text.
ADMIN_SESSION_SECRET=replace-with-a-long-random-value
# The built-in administrator. Without ADMIN_PASSWORD this account doesn't exist
# and staff sign in with Supabase accounts (npm run add-admin).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ua.edu.ph
ADMIN_PASSWORD=

# --- App -------------------------------------------------------------------------
# Used in password-reset links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Time zone for dates in messages and reports.
APP_TIMEZONE=Asia/Manila
